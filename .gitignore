# Certificates
# Certificate files are intentionally NOT ignored: drop real certificate
# files into public/certificates/ and register them in src/data/certificates.ts
# Temporary working files created while preparing certificates:
public/certificates/*.tmp
public/certificates/*.psd
public/certificates/*.fig
